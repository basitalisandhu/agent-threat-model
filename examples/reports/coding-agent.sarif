              }
            },
            {
              "id": "static-long-lived-credentials",
              "name": "StaticLongLivedCredentials",
              "shortDescription": {
                "text": "Static long-lived credentials held by the agent"
              },
              "fullDescription": {
                "text": "Tools authenticate with static keys that do not expire. If a key leaks through logs, prompts or an injected exfiltration it remains valid until someone notices, and it cannot be scoped to a single task."
              },
              "help": {
                "text": "Tools authenticate with static keys that do not expire. If a key leaks through logs, prompts or an injected exfiltration it remains valid until someone notices, and it cannot be scoped to a single task.",
                "markdown": "**Static long-lived credentials held by the agent**\n\nTools authenticate with static keys that do not expire. If a key leaks through logs, prompts or an injected exfiltration it remains valid until someone notices, and it cannot be scoped to a single task.\n\nSTRIDE: Information disclosure\nOWASP LLM Top 10 (2025): LLM02 Sensitive Information Disclosure\nOWASP Top 10 for Agentic Applications (2026): ASI03 Identity and Privilege Abuse\nMITRE ATLAS: [AML.T0055](https://atlas.mitre.org/techniques/AML.T0055), [AML.T0083](https://atlas.mitre.org/techniques/AML.T0083)\n\nMitigations: audit-log, brokered-credentials, secrets-out-of-context, kill-switch"
              },
              "helpUri": "https://genai.owasp.org/llm-top-10/",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
